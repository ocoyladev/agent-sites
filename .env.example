# --- Base de datos ---------------------------------------------------------
# El puerto 5435 evita chocar con los Postgres ya corriendo en ia-node
# (5432 sindicatos_db, 5433 sindicato_web_db, 5434 career_ops_db).
POSTGRES_USER=agencia
POSTGRES_PASSWORD=cambiar_esto
POSTGRES_DB=agencia
POSTGRES_PORT=5435
DATABASE_URL=postgresql+psycopg://agencia:cambiar_esto@localhost:5435/agencia

# --- Google Places API (New) ----------------------------------------------
# Consola: https://console.cloud.google.com/google/maps-apis
# Habilitar "Places API (New)". Restringir la key por API y por IP.
GOOGLE_PLACES_API_KEY=

# Tope de gasto por corrida. El cliente aborta antes de excederlo.
# Ver docs/adr/0002-google-places-field-masks.md para el modelo de costo.
PLACES_MAX_ENTERPRISE_CALLS_PER_RUN=350
PLACES_MAX_ATMOSPHERE_CALLS_PER_RUN=100
PLACES_MAX_PHOTO_CALLS_PER_RUN=100

# --- Motor de copywriting --------------------------------------------------
# 'auto' usa Gemini si hay key y cae a Ollama local si no.
# Valores: auto | gemini | ollama | ninguno
LLM_PROVEEDOR=auto
# Key de Google AI Studio (https://aistudio.google.com/apikey).
# OJO: es distinta de la de Places, aunque ambas sean de Google. Sin tarjeta.
GEMINI_API_KEY=
GEMINI_MODELO=gemini-2.5-flash
OLLAMA_MODELO=gemma4:26b

# --- Cloudflare Pages (deploy de sitios demo) -----------------------------
# Token con permiso "Cloudflare Pages: Edit":
#   https://dash.cloudflare.com/profile/api-tokens
# El Account ID esta en el panel de cualquier dominio, columna derecha.
# Ver docs/setup-cloudflare.md
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# UN solo proyecto para todos los sitios: Cloudflare limita a 100 proyectos por
# cuenta. Cada sitio se publica como alias de rama dentro de este proyecto, en
# https://<site_id>.<proyecto>.pages.dev
CLOUDFLARE_PAGES_PROJECT=agencia-demos

# --- Nicho y zona activos --------------------------------------------------
NICHO=abogados
CIUDAD=Arequipa
